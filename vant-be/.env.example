# Database (required)
# PostgreSQL connection string. Use DIRECT_DATABASE_URL for migrations when using Prisma Accelerate.
DATABASE_URL="postgresql://user:password@localhost:5432/vantai"

# Auth.js (required for Google sign-in)
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js base URL - set if backend port differs from default
# IMPORTANT: Add redirect URI to Google OAuth Console: {AUTH_URL}/callback/google
# Example for PORT=6969: http://localhost:6969/auth/callback/google
# AUTH_URL="http://localhost:6969/auth"

# Optional: Prisma Accelerate (use prisma:// URL for DATABASE_URL)
# DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/vantai"

# Optional: Server (3001 so frontend can use 3000)
PORT=6969

# Optional: Frontend URL for CORS and auth redirect (default: http://localhost:3000)
# FRONTEND_URL=http://localhost:3000

# Optional: Meeting bot defaults
# MEETING_URL="https://meet.google.com/new"
# BOT_NAME="Meeting Bot"
